{
  "rules": {
    "submissions": {
      ".read": "auth != null && auth.token.email === 'alexanderslowik2013@gmail.com'",
      ".write": "auth != null && auth.token.email === 'alexanderslowik2013@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.hasChildren(['nickname', 'answers', 'score', 'durationSeconds', 'submittedAt', 'questionCount'])",
        "nickname": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24" },
        "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
        "durationSeconds": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "questionCount": { ".validate": "newData.val() === 5" },
        "submittedAt": { ".validate": "newData.isNumber()" },
        "answers": {
          ".validate": "newData.hasChildren(['0','1','2','3','4'])",
          "$i": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" }
        },
        "$other": { ".validate": false }
      }
    }
  }
}